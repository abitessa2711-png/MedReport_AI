# ---- Database ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=medreport_user
DB_PASSWORD=change_me
DB_NAME=medreport_db

# ---- OCR ----
# Path to the tesseract binary. Leave blank on Linux/Mac if it's on PATH.
# On Windows this is usually: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Path to poppler's "bin" folder, needed by pdf2image on Windows.
# Leave blank on Linux/Mac if poppler-utils is installed via package manager.
POPPLER_PATH=

# ---- AI / LLM provider ----
# Which provider to use for generating the bilingual summary: "anthropic" or "openai"
AI_PROVIDER=anthropic

# Only one of these is required, matching AI_PROVIDER above
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- App ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
CORS_ORIGINS=http://localhost:5173
